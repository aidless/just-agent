# .env.example — copy to .env and fill in real values before running
#   docker compose up -d --build
#
# .env is git-ignored (see .gitignore). NEVER commit real secrets.
# docker compose reads .env automatically for variable interpolation.

# =========================================================================
#  Authentication  (the Evaluation access form will ask for this)
# =========================================================================
# Shared secret the leaderboard uses to call your Add/Search endpoints.
# Generate one, e.g.:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
AML_API_KEY=change-me-to-a-long-random-string

# Auth scheme sent by the leaderboard. The server accepts:
#   bearer   -> Authorization: Bearer <AML_API_KEY>
#   token    -> Authorization: Token  <AML_API_KEY>
#   x-api-key-> X-Api-Key: <AML_API_KEY>
# Pick the scheme you will report on the access form; they must match.
AML_AUTH_MODE=bearer

# =========================================================================
#  Host port  (container always listens on 8080 internally)
# =========================================================================
AML_HOST_PORT=8080

# =========================================================================
#  Optional path overrides  (official contract: shape is path-independent)
# =========================================================================
# AML_ADD_PATH=/add
# AML_SEARCH_PATH=/search
# AML_HEALTH_PATH=/health

# =========================================================================
#  Concurrency  (official disclosed: Add 64 workers / Search 32)
# =========================================================================
# AML_POOL_SIZE=24
# AML_BUSY_TIMEOUT_MS=10000

# =========================================================================
#  scnet.cn Kimi-K2.5 fact-extraction pipeline
# =========================================================================
# ONLY used when AML_FLAG_FACT_EXTRACTION=1 (default 0 = lexical-only).
# Obtain a key from your scnet.cn account. Leave blank to keep the pipeline
# disabled even if the flag is later flipped on — the module falls back to
# lexical-only retrieval when the key is absent or the API is unreachable.
SC_API_KEY=
SC_API_BASE=https://api.scnet.cn/v1

# Fact-extraction feature flag (maps to the `fact_extraction` ablation flag).
# 0 = OFF (default, deterministic lexical path only)
# 1 = ON  (calls scnet.cn at Add time; Search boosts fact-matched evidence)
# This is a forward-compatible no-op until the `fact_extraction` flag is
# added to DEFAULT_FLAGS in config.py by the fact-extraction pipeline task.
AML_FLAG_FACT_EXTRACTION=0
